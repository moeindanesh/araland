# Development database, local helper or Docker Compose (not production credentials)
DATABASE_URL=postgresql://araland:araland_dev@127.0.0.1:55432/araland
NODE_ENV=development
AUTH_DEV_MODE=true
# Set a private random value. Production requires at least 32 characters.
AUTH_SECRET=
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Relative to apps/api; keep the directory on a persistent volume in production
STORAGE_PATH=../../.storage
TRUST_PROXY=false
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
