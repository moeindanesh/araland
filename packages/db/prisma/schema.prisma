generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id          String       @id @default(cuid())
  phone       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  memberships Membership[]
  sessions    Session[]
  siteMembers SiteMember[]
}
model Workspace {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  sites       Site[]
}
model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("OWNER")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
}
model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  siteScopeId String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  @@index([phone, createdAt])
}
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  siteScopeId String?
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Site {
  id                  String      @id @default(cuid())
  workspaceId         String
  name                String
  slug                String      @unique
  templateId          String
  status              String      @default("DRAFT")
  draft               Json
  published           Json?
  publishedTemplateId String?
  publishedName       String?
  publishedSeo        Json?
  seo                 Json
  publishedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  workspace           Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  forms               SiteForm[]
  leads               Lead[]
  members             SiteMember[]
  files               SiteFile[]
  posts               Post[]
  domains             Domain[]
  media               Media[]
  visits              Visit[]
  @@index([workspaceId])
}
model SiteForm {
  id        String   @id @default(cuid())
  siteId    String
  title     String
  fields    Json
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  leads     Lead[]
  @@index([siteId])
}
model Lead {
  id        String    @id @default(cuid())
  siteId    String
  formId    String?
  formTitle String
  values    Json
  fieldLabels Json @default("{}")
  createdAt DateTime  @default(now())
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  form      SiteForm? @relation(fields: [formId], references: [id], onDelete: SetNull)
  @@index([siteId, createdAt])
}
model SiteMember {
  id        String   @id @default(cuid())
  siteId    String
  userId    String
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([siteId, userId])
}
model SiteFile {
  id             String   @id @default(cuid())
  siteId         String
  title          String
  originalName   String
  storageKey     String   @unique
  mimeType       String
  size           Int
  recipientPhone String
  createdAt      DateTime @default(now())
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@index([siteId, recipientPhone])
}
model Post {
  id        String   @id @default(cuid())
  siteId    String
  title     String
  slug      String
  excerpt   String
  body      String
  cover     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@unique([siteId, slug])
}
model Domain {
  id                String   @id @default(cuid())
  siteId            String
  hostname          String   @unique
  status            String   @default("PENDING")
  verificationToken String   @default(uuid())
  createdAt         DateTime @default(now())
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@index([siteId])
}
model Media {
  id           String   @id @default(cuid())
  siteId       String
  storageKey   String   @unique
  originalName String
  mimeType     String
  size         Int
  width        Int
  height       Int
  createdAt    DateTime @default(now())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@index([siteId])
}
model Visit {
  id        String   @id @default(cuid())
  siteId    String
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@index([siteId, createdAt])
}
